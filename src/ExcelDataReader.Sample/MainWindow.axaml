<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ExcelDataReader.Sample.MainWindow"
        Title="ExcelDataReader Sample"
        Width="1000"
        Height="650"
        MinWidth="720"
        MinHeight="480">
  <Grid RowDefinitions="Auto,*,Auto"
        RowSpacing="18"
        Margin="24">
    <StackPanel x:Name="LoadControls" Spacing="14">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <TextBox x:Name="FilePathTextBox"
                 IsReadOnly="True"
                 PlaceholderText="Choose an Excel or CSV file"
                 VerticalContentAlignment="Center" />
        <Button Grid.Column="1"
                Content="Browse..."
                MinWidth="110"
                Click="SelectFileClick" />
        <Button Grid.Column="2"
                x:Name="ProcessButton"
                Content="Load data"
                MinWidth="130"
                IsEnabled="False"
                Click="ProcessClick" />
      </Grid>

      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
        <CheckBox x:Name="FirstRowNamesCheckBox"
                  Content="First row has headers"
                  IsChecked="True" />
        <CheckBox Grid.Column="1"
                  x:Name="FillMergedCellsCheckBox"
                  Content="Fill merged cells"
                  IsChecked="True" />
        <CheckBox Grid.Column="2"
                  x:Name="SinglePassModeCheckBox"
                  Content="Single-pass mode" />
      </Grid>

    </StackPanel>

    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="10">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <TextBlock Text="Worksheet"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold" />
        <ComboBox Grid.Column="1"
                  x:Name="SheetComboBox"
                  MinWidth="260"
                  HorizontalAlignment="Left"
                  IsEnabled="False"
                  PlaceholderText="Select a sheet"
                  SelectionChanged="SheetSelectionChanged" />
      </Grid>

      <TableView x:Name="SheetTableView"
                 Grid.Row="1"
                 ClipToBounds="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </Grid>

    <TextBlock x:Name="StatusTextBlock"
               Grid.Row="2"
               VerticalAlignment="Center"
               Opacity="0.75" />
  </Grid>
</Window>
