 <Worksheet ss:Name="Precision">
  <Table ss:ExpandedColumnCount="3" ss:ExpandedRowCount="10" x:FullColumns="1"
   x:FullRows="1">
   <Column ss:Width="217.5"/>
   <Column ss:AutoFitWidth="0" ss:Width="152.25"/>
   <Column ss:Width="131.25"/>
   <Row>
    <Cell><Data ss:Type="String">To test numeric precision and negative numbers</Data></Cell>
   </Row>
   <Row ss:Index="3">
    <Cell><Data ss:Type="String">pi</Data></Cell>
    <Cell ss:StyleID="s18"><Data ss:Type="Number">3.14159265358979</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String" x:Ticked="1">-Ln(pi)</Data></Cell>
    <Cell ss:StyleID="s18"><Data ss:Type="Number">-3.14159265358979</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">A very small positive</Data></Cell>
    <Cell ss:StyleID="s19"><Data ss:Type="Number">3.1415926535897903E-300</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">A very small negative</Data></Cell>
    <Cell ss:StyleID="s19"><Data ss:Type="Number">-3.1415926535897903E-300</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">A very big positive</Data></Cell>
    <Cell ss:StyleID="s19"><Data ss:Type="Number">3.1415926535897931E+300</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">A very big negative</Data></Cell>
    <Cell ss:StyleID="s19"><Data ss:Type="Number">-3.1415926535897931E+300</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">A large positive integer</Data></Cell>
    <Cell ss:StyleID="s20"><Data ss:Type="Number">314159265358979</Data></Cell>
    <Cell ss:StyleID="s20"/>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">A large negative integer</Data></Cell>
    <Cell ss:StyleID="s21"><Data ss:Type="Number">-314159265358979</Data></Cell>
   </Row>
  </Table>
